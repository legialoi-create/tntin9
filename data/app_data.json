      "questions": [
        {
          "id": "q1",
          "number": 1,
          "content": "Trong phần mềm lập trình Scratch, khối lệnh nào dùng để thực hiện việc lặp lại một chuỗi hành động với số lần định trước?",
          "options": [
            {
              "id": "A",
              "text": "Khối lệnh repeat (lặp)"
            },
            {
              "id": "B",
              "text": "Khối lệnh forever (liên tục)"
            },
            {
              "id": "C",
              "text": "Khối lệnh if...then (nếu...thì)"
            },
            {
              "id": "D",
              "text": "Khối lệnh wait until (chờ cho đến khi)"
            }
          ],
          "correctAnswer": "A",
          "explanation": "Khối lệnh repeat cho phép lặp lại công việc với số lần xác định trước."
        },
        {
          "id": "q2",
          "number": 2,
          "content": "Mạng máy tính là gì?",
          "options": [
            {
              "id": "A",
              "text": "Tập hợp các máy tính nối kết với nhau theo một phương thức nào đó để chia sẻ tài nguyên"
            },
            {
              "id": "B",
              "text": "Tập hợp các máy tính hoạt động độc lập không kết nối với nhau"
            },
            {
              "id": "C",
              "text": "Nơi lưu trữ phần mềm máy tính"
            },
            {
              "id": "D",
              "text": "Dịch vụ giải trí trên Internet"
            }
          ],
          "correctAnswer": "A",
          "explanation": "Mạng máy tính là tập hợp các máy tính kết nối với nhau để chia sẻ dữ liệu và thiết bị."
        },
        {
          "id": "q3",
          "number": 3,
          "content": "Địa chỉ Email nào sau đây là hợp lệ?",
          "options": [
            {
              "id": "A",
              "text": "legialoi@gmail.com"
            },
            {
              "id": "B",
              "text": "legialoi#gmail.com"
            },
            {
              "id": "C",
              "text": "legialoi.gmail.com"
            },
            {
              "id": "D",
              "text": "legialoi@gmail@com"
            }
          ],
          "correctAnswer": "A",
          "explanation": "Địa chỉ email hợp lệ có cấu trúc [TênTàiKhoản]@[TênMiền]."
        },
        {
          "id": "q4",
          "number": 4,
          "content": "Trình duyệt web phổ biến hiện nay dùng để truy cập Internet là gì?",
          "options": [
            {
              "id": "A",
              "text": "Google Chrome, Microsoft Edge, Mozilla Firefox"
            },
            {
              "id": "B",
              "text": "Microsoft Word, Excel, PowerPoint"
            },
            {
              "id": "C",
              "text": "Pascal, C++, Python"
            },
            {
              "id": "D",
              "text": "Photoshop, Paint, Unikey"
            }
          ],
          "correctAnswer": "A",
          "explanation": "Chrome, Edge, Firefox là các phần mềm trình duyệt web."
        },
        {
          "id": "q5",
          "number": 5,
          "content": "Trong bảng tính Excel, để tính tổng các ô từ A1 đến A10 ta dùng hàm nào?",
          "options": [
            {
              "id": "A",
              "text": "=SUM(A1:A10)"
            },
            {
              "id": "B",
              "text": "=AVERAGE(A1:A10)"
            },
            {
              "id": "C",
              "text": "=COUNT(A1:A10)"
            },
            {
              "id": "D",
              "text": "=MAX(A1:A10)"
            }
          ],
          "correctAnswer": "A",
          "explanation": "Hàm SUM dùng để tính tổng chuỗi dữ liệu trong dải ô."
        }
      ],
